{
  "name": "anchor-mobile",
  "description": "A native personal planning starter for iOS and Android",
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "eas-build-pre-install": "node scripts/check-release.mjs",
    "verify": "npm run typecheck && npm test",
    "start:dev": "expo start --dev-client"
  },
  "dependencies": {
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-calendar": "~57.0.4",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-notifications": "~57.0.20",
    "expo-sharing": "~57.0.21",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.1"
  }
}
