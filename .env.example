# Optional for Expo Go; required before EAS/store builds.
APP_BUNDLE_ID=com.yourcompany.anchor
EAS_PROJECT_ID=

# Cloud shaper for iPhones without Apple Intelligence (phase 2b). Public URL,
# no secret (set after `wrangler deploy` in server/shape-worker): requests carry note text only, never audio.
EXPO_PUBLIC_SHAPE_URL=
# Free monthly cloud shapes per install (default 20).
EXPO_PUBLIC_FREE_SHAPE_QUOTA=

# Development builds only (__DEV__); stripped from and refused for release builds. Set on the Expo host, never commit real values.
# The matching server values belong in an ignored .env.processor file.
EXPO_PUBLIC_PROCESSOR_URL=
EXPO_PUBLIC_PROCESSOR_TOKEN=
