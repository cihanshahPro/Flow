# Dev voice processor (scripts/voice-server.mjs). Never commit a filled copy.
FLOW_PROCESSOR_TOKEN=            # >= 32 chars, same as EXPO_PUBLIC_PROCESSOR_TOKEN in the app's .env
FLOW_PROCESSOR_HOST=0.0.0.0
FLOW_PROCESSOR_PORT=8084
FLOW_WHISPER_MODEL=/path/to/ggml-large-v3-turbo.bin   # whisper.cpp model
FLOW_PROCESSING_TMP=/tmp/flow-processing
FLOW_SHAPER_BIN=/path/to/shape-thought                # swiftc -parse-as-library scripts/shape-thought.swift -o …  (macOS 26, Apple Intelligence)
FLOW_FIXTURES_DIR=/path/to/fixtures                   # optional: keeps every intake/chat as a replayable fixture
# The brain: either an API key…
# FLOW_ANTHROPIC_KEY=sk-ant-…
# …or your Claude subscription through Claude Code headless (claude → /login once on this Mac):
FLOW_CLAUDE_CODE=1
FLOW_CLAUDE_BIN=claude
FLOW_PLAN_MODEL=claude-sonnet-4-5
